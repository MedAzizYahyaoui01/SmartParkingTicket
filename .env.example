# Copy this file to .env and fill in real values. Never commit .env.

# --- MongoDB (Docker) ---
MONGO_ROOT_USER=parking
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=smart_parking

# --- mongo-express web UI (http://localhost:8081) ---
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me

# --- API ---
# Used when the API runs on Windows and MongoDB runs in the VM (port-forwarded to localhost).
# Inside Docker Compose this is overridden to point at the "mongo" service.
MONGO_URI=mongodb://parking:change-me@localhost:27017/?authSource=admin
# Shared secret the ESP32 sends in the X-API-Key header
API_KEY=change-me
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Firebase (filled in during Phase 3) ---
# FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.europe-west1.firebasedatabase.app
# FIREBASE_CREDENTIALS=./secrets/firebase-service-account.json

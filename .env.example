# Copy this file to .env and fill in real values. Never commit .env.

# --- MongoDB (Docker) ---
MONGO_ROOT_USER=parking
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=smart_parking

# --- mongo-express web UI (http://localhost:8081) ---
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me

# --- API ---
# Used when the API runs on Windows and MongoDB runs in the VM (port-forwarded to localhost).
# Inside Docker Compose this is overridden to point at the "mongo" service.
MONGO_URI=mongodb://parking:change-me@localhost:27018/?authSource=admin
# Shared secret the ESP32 sends in the X-API-Key header
API_KEY=change-me
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# Time zone of the parking (IANA name): statistics are grouped by local hour and weekday
TIMEZONE=Africa/Tunis

# --- Gate, accounts and wallet ---
# "account": the barrier opens only for signed-in users with credit (app, kiosk QR, chat).
# "auto": the old rule, any car gets in when a spot is free.
GATE_MODE=account
# Signs the login tokens: set a long random string (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-to-a-long-random-string
# Prices in millimes (1 TND = 1000): 2 TND/h, first 15 min free, 0.5 TND per reservation
HOURLY_RATE=2000
FREE_MINUTES=15
RESERVATION_FEE=500
MIN_ENTRY_BALANCE=1000

# --- Occupancy prediction ---
# Model written by `python -m app.ml.train` (relative to backend/); the API reloads it
# whenever the file changes.
# MODEL_PATH=models/best_model.joblib

# --- Assistant (chatbot) ---
# With a key the assistant uses Claude (understands EN/FR/AR and Darija freely);
# without one it answers with the built-in offline keyword rules.
ANTHROPIC_API_KEY=
# CHAT_ENGINE=auto          # auto | claude | rules
# CHAT_MODEL=claude-opus-5-5

# --- Firebase Realtime Database ---
# Leave empty to keep the live state in memory (tests, offline work).
# The credentials path is relative to backend/ (where the API is started).
FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_CREDENTIALS=../secrets/firebase-service-account.json

# --- Dashboard (React, read by Vite at build time: only VITE_* values reach the browser) ---
# Where the browser calls the API
VITE_API_URL=http://localhost:8000
# Same database as above. Leave empty and the dashboard polls the API instead of listening live.
VITE_FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.europe-west1.firebasedatabase.app
